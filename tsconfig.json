{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@earendil-works/pi-coding-agent": [
        "./.pi-sdk/@earendil-works/pi-coding-agent/dist/index.d.ts"
      ],
      "@earendil-works/pi-coding-agent/*": [
        "./.pi-sdk/@earendil-works/pi-coding-agent/*"
      ],
      "@earendil-works/pi-tui": [
        "./.pi-sdk/@earendil-works/pi-tui/dist/index.d.ts"
      ],
      "@earendil-works/pi-ai": [
        "./.pi-sdk/@earendil-works/pi-ai/dist/index.d.ts"
      ],
      "@earendil-works/pi-agent-core": [
        "./.pi-sdk/@earendil-works/pi-agent-core/dist/index.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts"
  ]
}